{
  "manifest_version": 3,
  "name": "Marketplace Intelligence",
  "version": "3.2.0",
  "description": "Inteligência e operações autônomas para marketplaces, direto no seu navegador autenticado. Sem APIs oficiais, sem cookies, sem tokens.",
  "key": "",
  "default_locale": "pt_BR",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.shopee.com.br/*",
    "https://sellercentral.amazon.com.br/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Marketplace Intelligence"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": [
        "content/dom-utils.js",
        "content/mercado-livre.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.shopee.com.br/*"
      ],
      "js": [
        "content/dom-utils.js",
        "content/shopee.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:*"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
