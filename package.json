{
  "name": "marketplace-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "Marketplace Intelligence & Autonomous Operations - monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "agent:build": "node scripts/build-local-agent.mjs",
    "host:build": "node scripts/build-native-host.mjs",
    "ext:build": "node scripts/build-extension.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "start:serve": "node dist/local-agent/main.js --serve"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}