{
  "name": "marketplace-intelligence",
  "private": true,
  "version": "3.13.0",
  "description": "Marketplace Intelligence — operação local, análise e inteligência de marketplaces",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "agent:build": "node scripts/build-local-agent.mjs",
    "host:build": "node scripts/build-native-host.mjs",
    "ext:build": "node scripts/build-extension.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "start:serve": "node dist/local-agent/main.js --serve",
    "audit": "node scripts/audit-project.mjs",
    "audit:publish": "node scripts/audit-publish-flow.mjs",
    "smoke:local": "node --experimental-strip-types scripts/smoke-local-features.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "0.28.2",
    "typescript": "^5.7.3",
    "vitest": "5.1.2"
  }
}
