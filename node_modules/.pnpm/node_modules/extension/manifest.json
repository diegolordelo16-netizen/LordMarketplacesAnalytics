{
  "manifest_version": 3,
  "name": "Lord Marketplaces Analytics",
  "version": "0.1.0",
  "description": "Inteligência operacional de marketplaces — captura na sessão autenticada do próprio usuário, sem APIs oficiais.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "alarms"],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolivre.com/*",
    "https://*.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Lord Marketplaces Analytics"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*", "https://*.shopee.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
